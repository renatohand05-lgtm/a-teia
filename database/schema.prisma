// A TEIA — Arquitetura Mestre 1.0 | Sprint 0
// Histórico de aprendizado NÃO é sobrescrito: métricas, diagnósticos,
// evidências, experimentos, memória, conversas e pesquisas são append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeKind {
  INTERNAL_DATA
  EXTERNAL_SOURCE
  INFERENCE
  HYPOTHESIS
  EVIDENCE
  RECOMMENDATION
}

enum DecisionStatus {
  DRAFT
  PENDING_HUMAN_APPROVAL
  APPROVED
  REJECTED
  DEFERRED
  EXECUTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum ExperimentStatus {
  PLANNED
  DRAFT
  READY
  RUNNING
  COMPLETED
  ABANDONED
  CANCELLED
}

enum ExperimentDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ExperimentClassification {
  VALIDATED
  PARTIALLY_VALIDATED
  INCONCLUSIVE
  REFUTED
}

enum AuditSource {
  USER
  SYSTEM
  AI
  RESEARCH
  IMPORT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ResearchStatus {
  PREPARED
  RUNNING
  COMPLETED
  FAILED
}

enum FilePurpose {
  IMPORT
  EVIDENCE
  ATTACHMENT
  OTHER
}

enum OnboardingStatus {
  DRAFT
  COMPLETE
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  VALIDATED
  REJECTED
  ARCHIVED
}

enum EvidenceLevel {
  HYPOTHESIS
  TESTING
  PARTIAL_EVIDENCE
  VALIDATED_EVIDENCE
}

enum OpportunityOrigin {
  SUGGESTED
  MANUAL
}

enum MemoryOrigin {
  OBSERVATION
  EXPERIMENT_EVIDENCE
  MANUAL_LESSON
}

enum MemoryConfidence {
  LOW
  MEDIUM
  HIGH
}

enum MemoryStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum MemoryPolarity {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum AIActionType {
  CREATE_EXPERIMENT
  CREATE_PLAN
  CREATE_OPPORTUNITY
}

enum AIActionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies         Company[]
  decisions         Decision[]
  actionPlans       ActionPlan[]
  tasks             Task[]
  conversations     AIConversation[]
  researchSessions  ResearchSession[]
  auditLogs         AuditLog[]
  uploadedFiles     StoredFile[]
  memories          StrategicMemory[]
  approvedMemories  StrategicMemory[] @relation("MemoryApprover")
  onboardings       CompanyOnboarding[]
  diagnoses         Diagnosis[]
  opportunities     Opportunity[]
  experiments       Experiment[]
  experimentResults ExperimentResult[]
  aiActionProposals AIActionProposal[]
}

model Company {
  id                   String        @id @default(cuid())
  name                 String
  segment              String?
  units                Int?
  revenueMonthly       Decimal?      @db.Decimal(14, 2)
  marginPercent        Decimal?      @db.Decimal(8, 2)
  teamSize             Int?
  channels             String?
  objectives           String?
  perceivedBottlenecks String?
  notes                String?
  status               CompanyStatus @default(ACTIVE)
  isDemo               Boolean       @default(false)
  archivedAt           DateTime?
  ownerId              String
  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  metrics              CompanyMetric[]
  financialRecords     FinancialRecord[]
  financialStatements  FinancialStatement[]
  financialGoals       FinancialGoal[]
  diagnoses            Diagnosis[]
  connectionsFrom    Connection[]      @relation("ConnectionFrom")
  connectionsTo      Connection[]      @relation("ConnectionTo")
  opportunities      Opportunity[]
  strategies         Strategy[]
  decisions          Decision[]
  actionPlans        ActionPlan[]
  experiments        Experiment[]
  evidence           Evidence[]
  memories           StrategicMemory[]
  conversations      AIConversation[]
  researchSessions   ResearchSession[]
  files              StoredFile[]
  onboarding         CompanyOnboarding?
  aiActionProposals  AIActionProposal[]

  @@index([ownerId, status])
  @@index([name])
}

/// Onboarding operacional 1:1 — editável, permite continuar depois.
model CompanyOnboarding {
  id                  String           @id @default(cuid())
  companyId           String           @unique
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedById         String?
  updatedBy           User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  city                String?
  state               String?
  averageTicket       Decimal?         @db.Decimal(14, 2)
  clientsPerMonth     Int?
  estimatedRecurrence String?
  status              OnboardingStatus @default(DRAFT)
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

/// Série histórica — novos períodos geram novas linhas, nunca overwrite.
model CompanyMetric {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  value     Decimal  @db.Decimal(16, 4)
  unit      String?
  period    String?
  capturedAt DateTime @default(now())
  sourceKind KnowledgeKind @default(INTERNAL_DATA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, name, capturedAt])
}

/// Lançamentos de caixa. Correção = novo registro. Sempre com competência mensal.
model FinancialRecord {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String
  category    String?
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("BRL")
  occurredAt  DateTime
  periodMonth Int
  periodYear  Int
  description String?
  sourceKind  KnowledgeKind @default(INTERNAL_DATA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId, occurredAt])
  @@index([companyId, periodYear, periodMonth])
}

/// DRE gerencial mensal. Campo nulo = sem dado informado. Zero = usuário registrou zero.
model FinancialStatement {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth   Int
  periodYear    Int
  grossRevenue  Decimal? @db.Decimal(14, 2)
  deductions    Decimal? @db.Decimal(14, 2)
  cogs          Decimal? @db.Decimal(14, 2)
  payroll       Decimal? @db.Decimal(14, 2)
  rent          Decimal? @db.Decimal(14, 2)
  water         Decimal? @db.Decimal(14, 2)
  energy        Decimal? @db.Decimal(14, 2)
  internet      Decimal? @db.Decimal(14, 2)
  marketing     Decimal? @db.Decimal(14, 2)
  delivery      Decimal? @db.Decimal(14, 2)
  accounting    Decimal? @db.Decimal(14, 2)
  maintenance   Decimal? @db.Decimal(14, 2)
  otherOpex     Decimal? @db.Decimal(14, 2)
  salesCount    Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
}

/// Metas financeiras da competência. Nulo = meta não definida.
model FinancialGoal {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth          Int
  periodYear           Int
  revenueTarget        Decimal? @db.Decimal(14, 2)
  ebitdaTarget         Decimal? @db.Decimal(14, 2)
  ebitdaPercentTarget  Decimal? @db.Decimal(8, 2)
  cogsPercentTarget    Decimal? @db.Decimal(8, 2)
  payrollPercentTarget Decimal? @db.Decimal(8, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
}

/// Histórico append-only. Novo diagnóstico = nova linha. Score 360 = (soma / 50) × 100.
model Diagnosis {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String
  summary        String?
  rawTotal       Int?
  overallScore   Int?
  bottleneck     String?
  bottlenecks    Json?
  maturity       String?
  scoresKind     KnowledgeKind @default(INTERNAL_DATA)
  bottleneckKind KnowledgeKind @default(INFERENCE)
  idempotencyKey String?       @unique
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  dimensions    DiagnosisDimension[]
  opportunities Opportunity[]

  @@index([companyId, createdAt])
}

/// Uma linha por dimensão de cada diagnóstico. Não sobrescreve histórico.
model DiagnosisDimension {
  id          String    @id @default(cuid())
  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  key         String    @default("legacy")
  name        String
  score       Int
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([diagnosisId, key])
  @@index([diagnosisId])
}

model Connection {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  from        Company  @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          Company  @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)
  type        String
  strength    Int?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromId])
  @@index([toId])
}

/// Motor de oportunidades. Hipótese de ação — nunca nasce como evidência validada.
/// investment = investimento estimado; expectedReturn = retorno mensal estimado; score = prioridade 0–100.
model Opportunity {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  diagnosisId        String?
  diagnosis          Diagnosis?         @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceDimension    String?
  templateKey        String?
  origin             OpportunityOrigin  @default(MANUAL)
  title              String
  description        String?
  problemStatement   String?
  hypothesis         String?
  expectedImpact     Int?
  urgency            Int?
  confidence         Int?
  effort             Int?
  investment         Decimal?           @db.Decimal(14, 2)
  estimatedHours     Decimal?           @db.Decimal(10, 2)
  expectedReturn     Decimal?           @db.Decimal(14, 2)
  paybackMonths      Decimal?           @db.Decimal(8, 2)
  score              Int?
  scorePartial       Boolean            @default(false)
  scoreReasons       Json?
  status             OpportunityStatus  @default(DRAFT)
  evidenceLevel      EvidenceLevel      @default(HYPOTHESIS)
  queuedForPlan      Boolean            @default(false)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  decisions   Decision[]
  experiments Experiment[]
  evidence    Evidence[]
  memories    StrategicMemory[]

  @@index([companyId, status])
  @@index([companyId, score])
  @@index([diagnosisId])
}

model Strategy {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  horizon     String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions   Decision[]
  experiments Experiment[]
  memories    StrategicMemory[]

  @@index([companyId])
}

/// Ações propostas pela IA jamais executam sozinhas — status inicia em PENDING_HUMAN_APPROVAL quando origem = AI.
model Decision {
  id             String         @id @default(cuid())
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  strategyId     String?
  strategy       Strategy?      @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String
  rationale      String?
  status         DecisionStatus @default(DRAFT)
  origin         AuditSource    @default(USER)
  requiresHumanApproval Boolean @default(true)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  deferredAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  actionPlans      ActionPlan[]
  researchSessions ResearchSession[]

  @@index([companyId, status])
}

model ActionPlan {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  decisionId  String?
  decision    Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title          String
  summary        String?
  horizonDays    Int?
  realizedCost   Decimal? @db.Decimal(14, 2)
  realizedReturn Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks       Task[]
  experiments Experiment[]
}

model Task {
  id           String     @id @default(cuid())
  actionPlanId String?
  actionPlan   ActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title        String
  details      String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Experiment {
  id                   String                     @id @default(cuid())
  companyId            String?
  company              Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId        String?
  opportunity          Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  actionPlanId         String?
  actionPlan           ActionPlan?                @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  strategyId           String?
  strategy             Strategy?                  @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title                String
  hypothesis           String?
  kpi                  String?
  kpiUnit              String?
  direction            ExperimentDirection        @default(HIGHER_IS_BETTER)
  baseline             Decimal?                   @db.Decimal(14, 4)
  target               Decimal?                   @db.Decimal(14, 4)
  testDescription      String?
  successCriteria      String?
  notes                String?
  investment           Decimal?                   @db.Decimal(14, 2)
  realizedInvestment   Decimal?                   @db.Decimal(14, 2)
  realizedReturn       Decimal?                   @db.Decimal(14, 2)
  status               ExperimentStatus           @default(PLANNED)
  classification       ExperimentClassification?
  classificationReason String?
  finalValue           Decimal?                   @db.Decimal(14, 4)
  startedAt            DateTime?
  plannedEndAt         DateTime?
  endedAt              DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  results  ExperimentResult[]
  evidence Evidence[]
  memories StrategicMemory[]

  @@index([companyId, status])
  @@index([opportunityId])
  @@index([actionPlanId])
}

/// Resultados nunca substituem o registro anterior — novo resultado = nova linha.
model ExperimentResult {
  id            String      @id @default(cuid())
  experimentId  String
  experiment    Experiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  recordedById  String?
  recordedBy    User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  outcome       String
  measuredValue Decimal?    @db.Decimal(14, 4)
  notes         String?
  recordedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([experimentId, recordedAt])
}

model Evidence {
  id             String                     @id @default(cuid())
  companyId      String?
  company        Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  experimentId   String?
  experiment     Experiment?                @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  kind           KnowledgeKind
  title          String
  body           String
  url            String?
  confidence     Int?
  classification ExperimentClassification?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  memories StrategicMemory[]

  @@index([companyId, kind])
  @@index([experimentId])
}

/// Memória estratégica é acumulativa: aprendizados novos não apagam os anteriores.
model StrategicMemory {
  id              String                     @id @default(cuid())
  companyId       String?
  company         Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  authorId        String?
  author          User?                      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title           String
  lesson          String
  validated       Boolean                    @default(false)
  origin          MemoryOrigin               @default(OBSERVATION)
  status          MemoryStatus               @default(PROPOSED)
  confidence      MemoryConfidence           @default(LOW)
  polarity        MemoryPolarity?
  evidenceId      String?
  evidence        Evidence?                  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  experimentId    String?
  experiment      Experiment?                @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  strategyId      String?
  strategy        Strategy?                  @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  context         String?
  segment         String?
  kpi             String?
  family          String?
  baseline        Decimal?                   @db.Decimal(14, 4)
  target          Decimal?                   @db.Decimal(14, 4)
  measuredResult  Decimal?                   @db.Decimal(14, 4)
  classification  ExperimentClassification?
  limitations     String?
  conditions      String?
  investment      Decimal?                   @db.Decimal(14, 2)
  periodStart     DateTime?
  periodEnd       DateTime?
  approvedById    String?
  approvedBy      User?                      @relation("MemoryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([origin, status])
  @@index([family, kpi])
  @@index([evidenceId])
  @@index([experimentId])
}

model AIConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title     String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages AIMessage[]
  proposals AIActionProposal[]
  researchSessions ResearchSession[]

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  knowledgeKind  KnowledgeKind?
  provider       String?
  model          String?
  structured     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sources    AISource[]
  proposals  AIActionProposal[]

  @@index([conversationId, createdAt])
}

model AISource {
  id          String        @id @default(cuid())
  messageId   String
  message     AIMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind        KnowledgeKind @default(EXTERNAL_SOURCE)
  title       String
  url         String?
  snippet     String?
  publisher   String?
  domain      String?
  publishedAt DateTime?
  accessedAt  DateTime?
  query       String?
  sourceType  String?
  freshness   String?
  rank        Int?
  claimType          String?
  qualityLevel       String?
  relevanceReason    String?
  rejectedReason     String?
  benchmarkEligible  Boolean?
  suspectedOutlier   Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AIActionProposal {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AIMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type           AIActionType
  title          String
  rationale      String
  payload        Json
  status         AIActionStatus @default(PENDING)
  confirmedAt    DateTime?
  resultEntity   String?
  resultId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, status])
  @@index([conversationId, createdAt])
}

model ResearchSession {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  decisionId     String?
  decision       Decision?       @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  question       String
  conclusion     String?
  status         ResearchStatus  @default(PREPARED)
  depth          String          @default("deep")
  query          String?
  cacheKey       String?
  provider       String?
  skippedReason  String?
  sourceCount    Int             @default(0)
  usedWeb        Boolean         @default(false)
  ranAt          DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  findings ResearchFinding[]

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, cacheKey, createdAt])
  @@index([conversationId, createdAt])
}

model ResearchFinding {
  id          String          @id @default(cuid())
  sessionId   String
  session     ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        KnowledgeKind
  title       String
  url         String?
  body        String?
  publisher   String?
  domain      String?
  publishedAt DateTime?
  accessedAt  DateTime?
  snippet     String?
  sourceType  String?
  freshness   String?
  rank        Int?
  query       String?
  claimType          String?
  qualityLevel       String?
  relevanceReason    String?
  rejectedReason     String?
  benchmarkEligible  Boolean?
  suspectedOutlier   Boolean?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StoredFile {
  id           String      @id @default(cuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  purpose      FilePurpose @default(OTHER)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  previousValue Json?
  newValue    Json?
  origin      AuditSource @default(USER)
  ip          String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
