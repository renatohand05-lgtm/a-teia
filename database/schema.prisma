// A TEIA — Arquitetura Mestre 1.0 | Sprint 0
// Histórico de aprendizado NÃO é sobrescrito: métricas, diagnósticos,
// evidências, experimentos, memória, conversas e pesquisas são append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeKind {
  INTERNAL_DATA
  EXTERNAL_SOURCE
  INFERENCE
  HYPOTHESIS
  EVIDENCE
  RECOMMENDATION
}

enum DecisionStatus {
  DRAFT
  PENDING_HUMAN_APPROVAL
  APPROVED
  REJECTED
  DEFERRED
  EXECUTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum ExperimentStatus {
  PLANNED
  DRAFT
  READY
  RUNNING
  COMPLETED
  ABANDONED
  CANCELLED
}

enum ExperimentDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ExperimentClassification {
  VALIDATED
  PARTIALLY_VALIDATED
  INCONCLUSIVE
  REFUTED
}

enum AuditSource {
  USER
  SYSTEM
  AI
  RESEARCH
  IMPORT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ResearchStatus {
  PREPARED
  RUNNING
  COMPLETED
  FAILED
}

enum FilePurpose {
  IMPORT
  EVIDENCE
  ATTACHMENT
  OTHER
}

enum OnboardingStatus {
  DRAFT
  COMPLETE
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  VALIDATED
  REJECTED
  ARCHIVED
}

enum EvidenceLevel {
  HYPOTHESIS
  TESTING
  PARTIAL_EVIDENCE
  VALIDATED_EVIDENCE
}

enum OpportunityOrigin {
  SUGGESTED
  MANUAL
  STRATEGY
  PLAYBOOK
}

enum PlaybookStatus {
  RASCUNHO
  EM_REVISAO
  VALIDADO
  ARQUIVADO
}

enum PlaybookOriginKind {
  MEMORY
  STRATEGY
  EXPERIMENT
  MANUAL
}

enum PlaybookApplicationStatus {
  PROPOSTA
  CONFIRMADA
  REJEITADA
  EM_TESTE
  ARQUIVADA
}

enum ConnectionStatus {
  SUGERIDA
  EM_ANALISE
  APROVADA
  EM_TESTE
  VALIDADA
  REJEITADA
  ARQUIVADA
}

enum ConnectionClassification {
  DADO_INTERNO
  INFERENCIA
  HIPOTESE
  EVIDENCIA
  MEMORIA_VALIDADA
  FONTE_EXTERNA
  RECOMENDACAO
}

enum StrategyStatus {
  RASCUNHO
  PROPOSTA
  APROVADA
  EM_TESTE
  VALIDADA
  REJEITADA
  ARQUIVADA
}

enum StrategyEffort {
  BAIXO
  MEDIO
  ALTO
  INDETERMINADO
}

enum StrategyRisk {
  BAIXO
  MODERADO
  ALTO
  INDETERMINADO
}

enum MemoryOrigin {
  OBSERVATION
  EXPERIMENT_EVIDENCE
  MANUAL_LESSON
}

enum MemoryConfidence {
  LOW
  MEDIUM
  HIGH
}

enum MemoryStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum MemoryPolarity {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum AllocationScenarioKind {
  CONSERVADOR
  BALANCEADO
  EXPANSAO
}

enum AllocationHorizon {
  DAYS_30
  DAYS_60
  DAYS_90
  MONTHS_6
  MONTHS_12
}

enum AllocationStatus {
  SIMULATION
  PROPOSAL
  SENT_TO_DECISION
  APPROVED
  REJECTED
}

enum AllocationEligibility {
  ELEGIVEL
  ELEGIVEL_COM_RESSALVAS
  DADOS_INSUFICIENTES
  BLOQUEADO
}

enum AllocationSourceKind {
  OPPORTUNITY
  PLAN
  EXPERIMENT
  DECISION
  PRIORITY
}

enum AllocationEvidenceClass {
  SEM_EVIDENCIA
  HIPOTESE
  SINAL_INICIAL
  EVIDENCIA_VALIDADA
}

enum AllocationRiskLevel {
  BAIXO
  MODERADO
  ALTO
  INDETERMINADO
}

enum AllocationReadiness {
  PRONTO
  PARCIAL
  INSUFICIENTE
}

enum AutomationKind {
  ALERTA
  LEMBRETE
  FOLLOW_UP
  CHECK
  RESUMO
  REVISAO
}

enum AutomationFrequency {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AlertPriority {
  CRITICO
  ALTO
  MEDIO
  BAIXO
}

enum AutomationRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum AutomationFailureKind {
  CONFIGURATION
  VALIDATION
  PROVIDER
  DATABASE
  RATE_LIMIT
  TIMEOUT
  UNKNOWN
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SLACK
}

enum AIActionType {
  CREATE_EXPERIMENT
  CREATE_PLAN
  CREATE_OPPORTUNITY
}

enum AIActionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies         Company[]
  decisions         Decision[]
  actionPlans       ActionPlan[]
  tasks             Task[]
  conversations     AIConversation[]
  researchSessions  ResearchSession[]
  auditLogs         AuditLog[]
  uploadedFiles     StoredFile[]
  memories          StrategicMemory[]
  approvedMemories  StrategicMemory[] @relation("MemoryApprover")
  onboardings       CompanyOnboarding[]
  diagnoses         Diagnosis[]
  opportunities     Opportunity[]
  experiments       Experiment[]
  experimentResults ExperimentResult[]
  aiActionProposals   AIActionProposal[]
  resourceBudget      ResourceBudget?
  allocationProposals AllocationProposal[]
  automations         Automation[]
  automationRuns      AutomationExecution[]
  automationAlerts    AutomationAlert[]
  notifications       AppNotification[]
  ownedConnections    Connection[] @relation("ConnectionOwner")
  reviewedConnections Connection[] @relation("ConnectionReviewer")
  approvedConnections Connection[] @relation("ConnectionApprover")
  ownedStrategies     Strategy[]   @relation("StrategyOwner")
  assignedStrategies  Strategy[]   @relation("StrategyAssignee")
  approvedStrategies  Strategy[]   @relation("StrategyApprover")
  ownedPlaybooks      Playbook[]   @relation("PlaybookOwner")
  createdPlaybooks    Playbook[]   @relation("PlaybookAuthor")
  reviewedPlaybooks   Playbook[]   @relation("PlaybookReviewer")
  approvedPlaybooks   Playbook[]   @relation("PlaybookApprover")
  playbookApplications PlaybookApplication[] @relation("PlaybookApplicationOwner")
}

model Company {
  id                   String        @id @default(cuid())
  name                 String
  segment              String?
  units                Int?
  revenueMonthly       Decimal?      @db.Decimal(14, 2)
  marginPercent        Decimal?      @db.Decimal(8, 2)
  teamSize             Int?
  channels             String?
  objectives           String?
  perceivedBottlenecks String?
  notes                String?
  status               CompanyStatus @default(ACTIVE)
  isDemo               Boolean       @default(false)
  archivedAt           DateTime?
  ownerId              String
  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  metrics              CompanyMetric[]
  financialRecords     FinancialRecord[]
  financialStatements  FinancialStatement[]
  financialGoals       FinancialGoal[]
  diagnoses            Diagnosis[]
  connectionsFrom         Connection[]      @relation("ConnectionFrom")
  connectionsTo           Connection[]      @relation("ConnectionTo")
  opportunities           Opportunity[]
  strategies              Strategy[]        @relation("StrategyOrigin")
  destinationStrategies   Strategy[]        @relation("StrategyDestination")
  decisions          Decision[]
  actionPlans        ActionPlan[]
  experiments        Experiment[]
  evidence           Evidence[]
  memories           StrategicMemory[]
  conversations      AIConversation[]
  researchSessions   ResearchSession[]
  files              StoredFile[]
  onboarding         CompanyOnboarding?
  aiActionProposals  AIActionProposal[]
  allocationItems    AllocationItem[]
  automations        Automation[]
  automationAlerts   AutomationAlert[]
  auditLogs          AuditLog[]
  originPlaybooks    Playbook[]            @relation("PlaybookOrigin")
  playbookApplications PlaybookApplication[] @relation("PlaybookApplicationDestination")

  @@index([ownerId, status])
  @@index([name])
}

/// Onboarding operacional 1:1 — editável, permite continuar depois.
model CompanyOnboarding {
  id                  String           @id @default(cuid())
  companyId           String           @unique
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedById         String?
  updatedBy           User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  city                String?
  state               String?
  averageTicket       Decimal?         @db.Decimal(14, 2)
  clientsPerMonth     Int?
  estimatedRecurrence String?
  status              OnboardingStatus @default(DRAFT)
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

/// Série histórica — novos períodos geram novas linhas, nunca overwrite.
model CompanyMetric {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  value     Decimal  @db.Decimal(16, 4)
  unit      String?
  period    String?
  capturedAt DateTime @default(now())
  sourceKind KnowledgeKind @default(INTERNAL_DATA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, name, capturedAt])
}

/// Lançamentos de caixa. Correção = novo registro. Sempre com competência mensal.
model FinancialRecord {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String
  category    String?
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("BRL")
  occurredAt  DateTime
  periodMonth Int
  periodYear  Int
  description String?
  sourceKind  KnowledgeKind @default(INTERNAL_DATA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId, occurredAt])
  @@index([companyId, periodYear, periodMonth])
}

/// DRE gerencial mensal. Campo nulo = sem dado informado. Zero = usuário registrou zero.
model FinancialStatement {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth   Int
  periodYear    Int
  grossRevenue  Decimal? @db.Decimal(14, 2)
  deductions    Decimal? @db.Decimal(14, 2)
  cogs          Decimal? @db.Decimal(14, 2)
  payroll       Decimal? @db.Decimal(14, 2)
  rent          Decimal? @db.Decimal(14, 2)
  water         Decimal? @db.Decimal(14, 2)
  energy        Decimal? @db.Decimal(14, 2)
  internet      Decimal? @db.Decimal(14, 2)
  marketing     Decimal? @db.Decimal(14, 2)
  delivery      Decimal? @db.Decimal(14, 2)
  accounting    Decimal? @db.Decimal(14, 2)
  maintenance   Decimal? @db.Decimal(14, 2)
  otherOpex     Decimal? @db.Decimal(14, 2)
  salesCount    Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
}

/// Metas financeiras da competência. Nulo = meta não definida.
model FinancialGoal {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth          Int
  periodYear           Int
  revenueTarget        Decimal? @db.Decimal(14, 2)
  ebitdaTarget         Decimal? @db.Decimal(14, 2)
  ebitdaPercentTarget  Decimal? @db.Decimal(8, 2)
  cogsPercentTarget    Decimal? @db.Decimal(8, 2)
  payrollPercentTarget Decimal? @db.Decimal(8, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
}

/// Histórico append-only. Novo diagnóstico = nova linha. Score 360 = (soma / 50) × 100.
model Diagnosis {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String
  summary        String?
  rawTotal       Int?
  overallScore   Int?
  bottleneck     String?
  bottlenecks    Json?
  maturity       String?
  scoresKind     KnowledgeKind @default(INTERNAL_DATA)
  bottleneckKind KnowledgeKind @default(INFERENCE)
  idempotencyKey String?       @unique
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  dimensions    DiagnosisDimension[]
  opportunities Opportunity[]

  @@index([companyId, createdAt])
}

/// Uma linha por dimensão de cada diagnóstico. Não sobrescreve histórico.
model DiagnosisDimension {
  id          String    @id @default(cuid())
  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  key         String    @default("legacy")
  name        String
  score       Int
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([diagnosisId, key])
  @@index([diagnosisId])
}

model Connection {
  id                   String                   @id @default(cuid())
  ownerId              String
  owner                User                     @relation("ConnectionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  fromId               String
  toId                 String
  from                 Company                  @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to                   Company                  @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)
  type                 String
  strength             Int?
  note                 String?
  status               ConnectionStatus         @default(SUGERIDA)
  classification       ConnectionClassification @default(HIPOTESE)
  mechanism            String?
  hypothesis           String?
  justification        String?
  limitations          String?
  nextAction           String?
  score                Int?
  scorePartial         Boolean                  @default(true)
  scoreReasons         Json?
  scoreFactorsUsed     Json?
  scoreFactorsMissing  Json?
  scoreVersion         String?
  scoredAt             DateTime?
  potential            Decimal?                 @db.Decimal(14, 2)
  usedCompanyFields    Json?
  usedMemoryIds        Json?
  usedEvidenceIds      Json?
  usedExternalSourceIds Json?
  discoveryKey         String?                  @unique
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?                    @relation("ConnectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?                    @relation("ConnectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt           DateTime?
  archivedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  strategies           Strategy[]
  playbooks            Playbook[]

  @@unique([ownerId, fromId, toId, type])
  @@index([ownerId, status])
  @@index([fromId])
  @@index([toId])
}

/// Motor de oportunidades. Hipótese de ação — nunca nasce como evidência validada.
/// investment = investimento estimado; expectedReturn = retorno mensal estimado; score = prioridade 0–100.
model Opportunity {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  diagnosisId        String?
  diagnosis          Diagnosis?         @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceDimension    String?
  templateKey        String?
  origin             OpportunityOrigin  @default(MANUAL)
  title              String
  description        String?
  problemStatement   String?
  hypothesis         String?
  expectedImpact     Int?
  urgency            Int?
  confidence         Int?
  effort             Int?
  investment         Decimal?           @db.Decimal(14, 2)
  estimatedHours     Decimal?           @db.Decimal(10, 2)
  expectedReturn     Decimal?           @db.Decimal(14, 2)
  paybackMonths      Decimal?           @db.Decimal(8, 2)
  score              Int?
  scorePartial       Boolean            @default(false)
  scoreReasons       Json?
  status             OpportunityStatus  @default(DRAFT)
  evidenceLevel      EvidenceLevel      @default(HYPOTHESIS)
  queuedForPlan      Boolean            @default(false)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  decisions   Decision[]
  experiments Experiment[]
  evidence    Evidence[]
  memories    StrategicMemory[]
  strategies  Strategy[]
  playbooks   Playbook[]
  playbookApplications PlaybookApplication[]

  @@index([companyId, status])
  @@index([companyId, score])
  @@index([diagnosisId])
}

model Strategy {
  id                    String                   @id @default(cuid())
  ownerId               String
  owner                 User                     @relation("StrategyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  companyId             String
  company               Company                  @relation("StrategyOrigin", fields: [companyId], references: [id], onDelete: Cascade)
  destinationCompanyId  String?
  destination           Company?                 @relation("StrategyDestination", fields: [destinationCompanyId], references: [id], onDelete: SetNull)
  connectionId          String?
  connection            Connection?              @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  opportunityId         String?                  @unique
  opportunity           Opportunity?             @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  horizon               String?
  status                StrategyStatus           @default(RASCUNHO)
  mechanism             String?
  problem               String?
  hypothesis            String?
  audience              String?
  valueProposition      String?
  primaryKpi            String?
  secondaryKpi          String?
  estimatedInvestment   Decimal?                 @db.Decimal(14, 2)
  effort                StrategyEffort           @default(INDETERMINADO)
  testHorizonDays       Int?
  risk                  StrategyRisk             @default(INDETERMINADO)
  recommendationOrigin  ConnectionClassification @default(HIPOTESE)
  internalSources       Json?
  externalSources       Json?
  evidenceIds           Json?
  memoryIds             Json?
  assigneeId            String?
  assignee              User?                    @relation("StrategyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?                    @relation("StrategyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  convertedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  decisions   Decision[]
  experiments Experiment[]
  memories    StrategicMemory[]
  playbooks   Playbook[]

  @@index([ownerId, status])
  @@index([companyId])
  @@index([destinationCompanyId])
  @@index([connectionId])
}

/// Playbook registra o que foi feito, em qual contexto e com qual resultado. Não é garantia.
model Playbook {
  id                      String             @id @default(cuid())
  ownerId                 String
  owner                   User               @relation("PlaybookOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  originCompanyId         String
  originCompany           Company            @relation("PlaybookOrigin", fields: [originCompanyId], references: [id], onDelete: Cascade)
  strategyId              String?
  strategy                Strategy?          @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  opportunityId           String?
  opportunity             Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  experimentId            String?
  experiment              Experiment?        @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  evidenceId              String?
  evidence                Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  memoryId                String?
  memory                  StrategicMemory?   @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  connectionId            String?
  connection              Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdById             String?
  createdBy               User?              @relation("PlaybookAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById            String?
  reviewedBy              User?              @relation("PlaybookReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedById            String?
  approvedBy              User?              @relation("PlaybookApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  title                   String
  family                  String?
  description             String?
  problem                 String?
  originSegment           String?
  scenario                String?
  preconditions           String?
  audience                String?
  limitations             String?
  risks                   String?
  steps                   Json?
  durationDays            Int?
  resources               String?
  observedInvestment      Decimal?           @db.Decimal(14, 2)
  suggestedOwner          String?
  dependencies            String?
  primaryKpi              String?
  secondaryKpis           Json?
  baseline                Decimal?           @db.Decimal(14, 4)
  target                  Decimal?           @db.Decimal(14, 4)
  observedResult          Decimal?           @db.Decimal(14, 4)
  observedResultText      String?
  confidence              Int?
  originKind              PlaybookOriginKind @default(MANUAL)
  status                  PlaybookStatus     @default(RASCUNHO)
  compatibleSegments      Json?
  requiredConditions      String?
  recommendedAdaptations  String?
  contrarySignals         String?
  reviewedAt              DateTime?
  approvedAt              DateTime?
  archivedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  applications            PlaybookApplication[]

  @@index([ownerId, status])
  @@index([originCompanyId])
  @@index([family, originSegment])
  @@index([memoryId])
  @@index([strategyId])
  @@index([evidenceId])
}

model PlaybookApplication {
  id                   String                     @id @default(cuid())
  ownerId              String
  owner                User                       @relation("PlaybookApplicationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  playbookId           String
  playbook             Playbook                   @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  destinationCompanyId String
  destination          Company                    @relation("PlaybookApplicationDestination", fields: [destinationCompanyId], references: [id], onDelete: Cascade)
  opportunityId        String?
  opportunity          Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  status               PlaybookApplicationStatus  @default(PROPOSTA)
  compatibilityScore   Int?
  scorePartial         Boolean                    @default(true)
  scoreVersion         String?
  scoredAt             DateTime?
  factorsUsed          Json?
  factorsMissing       Json?
  favorable            Json?
  contrary             Json?
  limitations          String?
  adaptedHypothesis    String?
  kpi                  String?
  horizonDays          Int?
  investment           Decimal?                   @db.Decimal(14, 2)
  classification       KnowledgeKind              @default(HYPOTHESIS)
  proposedAt           DateTime                   @default(now())
  confirmedAt          DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([playbookId, destinationCompanyId])
  @@index([ownerId, status])
  @@index([destinationCompanyId])
  @@index([opportunityId])
}

/// Ações propostas pela IA jamais executam sozinhas — status inicia em PENDING_HUMAN_APPROVAL quando origem = AI.
model Decision {
  id             String         @id @default(cuid())
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  strategyId     String?
  strategy       Strategy?      @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String
  rationale      String?
  humanReason    String?
  status         DecisionStatus @default(DRAFT)
  origin         AuditSource    @default(USER)
  requiresHumanApproval Boolean @default(true)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  deferredAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  actionPlans          ActionPlan[]
  researchSessions     ResearchSession[]
  allocationProposals  AllocationProposal[]

  @@index([companyId, status])
}

model ActionPlan {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  decisionId  String?
  decision    Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title          String
  summary        String?
  horizonDays    Int?
  realizedCost   Decimal? @db.Decimal(14, 2)
  realizedReturn Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks       Task[]
  experiments Experiment[]
}

model Task {
  id           String     @id @default(cuid())
  actionPlanId String?
  actionPlan   ActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title        String
  details      String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Experiment {
  id                   String                     @id @default(cuid())
  companyId            String?
  company              Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId        String?
  opportunity          Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  actionPlanId         String?
  actionPlan           ActionPlan?                @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  strategyId           String?
  strategy             Strategy?                  @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title                String
  hypothesis           String?
  kpi                  String?
  kpiUnit              String?
  direction            ExperimentDirection        @default(HIGHER_IS_BETTER)
  baseline             Decimal?                   @db.Decimal(14, 4)
  target               Decimal?                   @db.Decimal(14, 4)
  testDescription      String?
  successCriteria      String?
  notes                String?
  investment           Decimal?                   @db.Decimal(14, 2)
  realizedInvestment   Decimal?                   @db.Decimal(14, 2)
  realizedReturn       Decimal?                   @db.Decimal(14, 2)
  status               ExperimentStatus           @default(PLANNED)
  classification       ExperimentClassification?
  classificationReason String?
  finalValue           Decimal?                   @db.Decimal(14, 4)
  startedAt            DateTime?
  plannedEndAt         DateTime?
  endedAt              DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  results  ExperimentResult[]
  evidence Evidence[]
  memories StrategicMemory[]
  playbooks Playbook[]

  @@index([companyId, status])
  @@index([opportunityId])
  @@index([actionPlanId])
}

/// Resultados nunca substituem o registro anterior — novo resultado = nova linha.
model ExperimentResult {
  id            String      @id @default(cuid())
  experimentId  String
  experiment    Experiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  recordedById  String?
  recordedBy    User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  outcome       String
  measuredValue Decimal?    @db.Decimal(14, 4)
  notes         String?
  recordedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([experimentId, recordedAt])
}

model Evidence {
  id             String                     @id @default(cuid())
  companyId      String?
  company        Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  experimentId   String?
  experiment     Experiment?                @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  kind           KnowledgeKind
  title          String
  body           String
  url            String?
  confidence     Int?
  classification ExperimentClassification?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  memories StrategicMemory[]
  playbooks Playbook[]

  @@index([companyId, kind])
  @@index([experimentId])
}

/// Memória estratégica é acumulativa: aprendizados novos não apagam os anteriores.
model StrategicMemory {
  id              String                     @id @default(cuid())
  companyId       String?
  company         Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  authorId        String?
  author          User?                      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title           String
  lesson          String
  validated       Boolean                    @default(false)
  origin          MemoryOrigin               @default(OBSERVATION)
  status          MemoryStatus               @default(PROPOSED)
  confidence      MemoryConfidence           @default(LOW)
  polarity        MemoryPolarity?
  evidenceId      String?
  evidence        Evidence?                  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  experimentId    String?
  experiment      Experiment?                @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  strategyId      String?
  strategy        Strategy?                  @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  context         String?
  segment         String?
  kpi             String?
  family          String?
  baseline        Decimal?                   @db.Decimal(14, 4)
  target          Decimal?                   @db.Decimal(14, 4)
  measuredResult  Decimal?                   @db.Decimal(14, 4)
  classification  ExperimentClassification?
  limitations     String?
  conditions      String?
  investment      Decimal?                   @db.Decimal(14, 2)
  periodStart     DateTime?
  periodEnd       DateTime?
  approvedById    String?
  approvedBy      User?                      @relation("MemoryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  playbooks Playbook[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([origin, status])
  @@index([family, kpi])
  @@index([evidenceId])
  @@index([experimentId])
}

model AIConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title     String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages AIMessage[]
  proposals AIActionProposal[]
  researchSessions ResearchSession[]

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  knowledgeKind  KnowledgeKind?
  provider       String?
  model          String?
  structured     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sources    AISource[]
  proposals  AIActionProposal[]

  @@index([conversationId, createdAt])
}

model AISource {
  id          String        @id @default(cuid())
  messageId   String
  message     AIMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind        KnowledgeKind @default(EXTERNAL_SOURCE)
  title       String
  url         String?
  snippet     String?
  publisher   String?
  domain      String?
  publishedAt DateTime?
  accessedAt  DateTime?
  query       String?
  sourceType  String?
  freshness   String?
  rank        Int?
  claimType          String?
  qualityLevel       String?
  relevanceReason    String?
  rejectedReason     String?
  benchmarkEligible  Boolean?
  suspectedOutlier   Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AIActionProposal {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AIMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type           AIActionType
  title          String
  rationale      String
  payload        Json
  status         AIActionStatus @default(PENDING)
  confirmedAt    DateTime?
  resultEntity   String?
  resultId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, status])
  @@index([conversationId, createdAt])
}

model ResearchSession {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  decisionId     String?
  decision       Decision?       @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  question       String
  conclusion     String?
  status         ResearchStatus  @default(PREPARED)
  depth          String          @default("deep")
  query          String?
  cacheKey       String?
  provider       String?
  skippedReason  String?
  sourceCount    Int             @default(0)
  usedWeb        Boolean         @default(false)
  ranAt          DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  findings ResearchFinding[]

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, cacheKey, createdAt])
  @@index([conversationId, createdAt])
}

model ResearchFinding {
  id          String          @id @default(cuid())
  sessionId   String
  session     ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        KnowledgeKind
  title       String
  url         String?
  body        String?
  publisher   String?
  domain      String?
  publishedAt DateTime?
  accessedAt  DateTime?
  snippet     String?
  sourceType  String?
  freshness   String?
  rank        Int?
  query       String?
  claimType          String?
  qualityLevel       String?
  relevanceReason    String?
  rejectedReason     String?
  benchmarkEligible  Boolean?
  suspectedOutlier   Boolean?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StoredFile {
  id           String      @id @default(cuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  purpose      FilePurpose @default(OTHER)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action        String
  entity        String
  entityId      String?
  category      String?
  success       Boolean     @default(true)
  previousValue Json?
  newValue      Json?
  origin        AuditSource @default(USER)
  ip            String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([companyId, createdAt])
  @@index([category, createdAt])
  @@index([success, createdAt])
}

/// Orçamento do owner. Nulo = não informado. Nunca inventar disponibilidade.
model ResourceBudget {
  id                      String            @id @default(cuid())
  ownerId                 String            @unique
  owner                   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  capitalAvailable        Decimal?          @db.Decimal(14, 2)
  hoursAvailable          Decimal?          @db.Decimal(10, 2)
  capacityLimit           Int?
  reserveMinimum          Decimal?          @db.Decimal(14, 2)
  maxPerCompany           Decimal?          @db.Decimal(14, 2)
  maxPerInitiative        Decimal?          @db.Decimal(14, 2)
  maxPercentPerInitiative Decimal?          @db.Decimal(8, 2)
  horizon                 AllocationHorizon @default(DAYS_90)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

/// Simulação/proposta versionada. Nova simulação não sobrescreve decisão aprovada.
model AllocationProposal {
  id                      String                 @id @default(cuid())
  ownerId                 String
  owner                   User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  version                 Int
  status                  AllocationStatus       @default(SIMULATION)
  scenario                AllocationScenarioKind @default(BALANCEADO)
  horizon                 AllocationHorizon      @default(DAYS_90)
  capitalAvailable        Decimal?               @db.Decimal(14, 2)
  hoursAvailable          Decimal?               @db.Decimal(10, 2)
  capacityLimit           Int?
  reserveMinimum          Decimal?               @db.Decimal(14, 2)
  maxPerCompany           Decimal?               @db.Decimal(14, 2)
  maxPerInitiative        Decimal?               @db.Decimal(14, 2)
  maxPercentPerInitiative Decimal?               @db.Decimal(8, 2)
  capitalAllocated        Decimal?               @db.Decimal(14, 2)
  capitalPreserved        Decimal?               @db.Decimal(14, 2)
  hoursAllocated          Decimal?               @db.Decimal(10, 2)
  hoursPreserved          Decimal?               @db.Decimal(10, 2)
  snapshot                Json
  decisionId              String?
  decision                Decision?              @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  actionPlanId            String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  items AllocationItem[]

  @@unique([ownerId, version])
  @@index([ownerId, status, createdAt])
}

model AllocationItem {
  id              String                   @id @default(cuid())
  proposalId      String
  proposal        AllocationProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceKind      AllocationSourceKind
  sourceId        String
  title           String
  allocated       Boolean                  @default(false)
  skipReason      String?
  eligibility     AllocationEligibility
  readiness       AllocationReadiness
  risk            AllocationRiskLevel
  evidenceClass   AllocationEvidenceClass
  capital         Decimal?                 @db.Decimal(14, 2)
  hours           Decimal?                 @db.Decimal(10, 2)
  expectedReturn  Decimal?                 @db.Decimal(14, 2)
  paybackMonths   Decimal?                 @db.Decimal(8, 2)
  estimatedRoiBps Int?
  rationale       String?
  explanation     Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([proposalId, allocated])
  @@index([companyId])
}

/// Automação do owner. companyId nulo = portfólio. Condição em JSON, avaliação determinística.
model Automation {
  id            String               @id @default(cuid())
  ownerId       String
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  kind          AutomationKind       @default(ALERTA)
  templateKey   String
  title         String
  description   String?
  enabled       Boolean              @default(false)
  frequency     AutomationFrequency  @default(DAILY)
  condition     Json
  cooldownHours Int                  @default(24)
  priority      AlertPriority        @default(MEDIO)
  timezone      String               @default("America/Sao_Paulo")
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  executions AutomationExecution[]
  alerts     AutomationAlert[]

  @@index([ownerId, enabled, nextRunAt])
  @@index([companyId])
}

model AutomationExecution {
  id             String                @id @default(cuid())
  ownerId        String
  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  automationId   String?
  automation     Automation?           @relation(fields: [automationId], references: [id], onDelete: SetNull)
  idempotencyKey String                @unique
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?
  status         AutomationRunStatus   @default(SUCCESS)
  failureKind    AutomationFailureKind?
  summary        String?
  itemsProcessed Int                   @default(0)
  alertsCreated  Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([ownerId, startedAt])
  @@index([automationId, startedAt])
}

model AutomationAlert {
  id             String        @id @default(cuid())
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  automationId   String?
  automation     Automation?   @relation(fields: [automationId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  kind           AutomationKind @default(ALERTA)
  title          String
  message        String
  priority       AlertPriority @default(MEDIO)
  status         AlertStatus   @default(OPEN)
  ruleKey        String
  idempotencyKey String        @unique
  facts          Json
  href           String?
  detectedAt     DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  dismissedAt    DateTime?
  resolvedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  notifications AppNotification[]

  @@index([ownerId, status, detectedAt])
  @@index([ownerId, ruleKey, companyId])
  @@index([automationId])
}

model AppNotification {
  id         String              @id @default(cuid())
  ownerId    String
  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  alertId    String?
  alert      AutomationAlert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  href       String?
  readAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([ownerId, readAt, createdAt])
}
