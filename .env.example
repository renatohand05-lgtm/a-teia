# A TEIA — Sprint 0
# Copie este arquivo para .env.local (desenvolvimento) e configure na Vercel (produção).
# Nunca commite .env, .env.local ou chaves reais.

# PostgreSQL (Neon, Vercel Postgres, Prisma Postgres ou instância própria)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/a_teia?sslmode=require"

# Auth.js / NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
# URL pública (produção)
AUTH_URL="http://localhost:3000"

# Único usuário principal desta fase (criado/atualizado pelo seed)
AUTH_EMAIL="renato@a-teia.local"
AUTH_PASSWORD="altere-esta-senha-agora"
AUTH_NAME="Renato"

# OpenAI — usada apenas no servidor, nunca no frontend
# Deixe vazio nesta sprint se ainda não for ativar a IA
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Pesquisa web futura (não ativada automaticamente na Sprint 0)
WEB_SEARCH_PROVIDER="none"
WEB_SEARCH_API_KEY=""

# Storage de arquivos/importações (preparado; Sprint 0 usa disco local ou Vercel Blob)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# Cron — Vercel injeta CRON_SECRET quando o cron está no vercel.json.
# Deixe vazio localmente. Nunca commite um valor real.
CRON_SECRET=""

# Ambiente
NODE_ENV="development"
APP_ENV="development"
